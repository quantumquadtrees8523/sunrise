#!/usr/bin/env bash
# box-secret — the owner stores, the agent references.
#
#   box-secret set   <name>   # OWNER runs this. Prompts. Nothing echoes.
#   box-secret get   <name>   # prints the value and nothing else
#   box-secret check <name>   # exit 0/1, prints no secret
#   box-secret rm    <name>
#
# Backed by the macOS Keychain, or libsecret (secret-tool) on Linux.
# Nothing is ever written to disk.
#
# The agent only ever writes the `get` form, inline, so the value exists for the
# lifetime of one command substitution and never lands in a file or a variable
# it controls:
#
#   curl -H "Authorization: Bearer $(box-secret get ha-token)" ...
#
# NOTE: that protects the STORE, not your terminal. Commands that echo their own
# arguments back (`claude mcp add --header` does) will still print the value.
#
# Compatibility: this replaces `sunrise-secret`. Secrets it stored (keychain
# service "sunrise:<name>", libsecret service "sunrise") are still found by
# get/check/rm, so nobody has to re-enter or copy a value. New `set`s go to
# the "box-secret" service.

set -u
SERVICE="box-secret"
LEGACY="sunrise"

die() { printf '%s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

backend() {
  if command -v security   >/dev/null 2>&1 && [ "$(uname -s)" = "Darwin" ]; then echo keychain
  elif command -v secret-tool >/dev/null 2>&1; then echo libsecret
  else die "No credential store found. Need macOS 'security' or Linux 'secret-tool' (libsecret-tools)."
  fi
}

read_silent() { # prompt on tty, echo nothing, return the line
  local v
  printf 'Paste the value for "%s" (input hidden), then press Enter: ' "$1" > /dev/tty
  IFS= read -rs v < /dev/tty
  printf '\n' > /dev/tty
  [ -n "$v" ] || die "Empty value; nothing stored."
  printf '%s' "$v"
}

cmd=${1:-}; name=${2:-}
[ -n "$cmd" ] && [ -n "$name" ] || usage
case "$name" in *[!a-zA-Z0-9_-]*) die "Name must be [a-zA-Z0-9_-]." ;; esac
missing="No secret named '$name'. The owner runs: $0 set $name"

case "$(backend)" in
keychain)
  kc_get() { security find-generic-password -a "$USER" -s "$1:$name" -w 2>/dev/null; }
  case "$cmd" in
    set)   v=$(read_silent "$name")
           security add-generic-password -U -a "$USER" -s "$SERVICE:$name" -w "$v" \
             >/dev/null 2>&1 || die "Keychain write failed."
           unset v; echo "stored $name" ;;
    get)   kc_get "$SERVICE" || kc_get "$LEGACY" || die "$missing" ;;
    check) { kc_get "$SERVICE" || kc_get "$LEGACY"; } >/dev/null 2>&1 && exit 0 || exit 1 ;;
    rm)    { security delete-generic-password -a "$USER" -s "$SERVICE:$name" >/dev/null 2>&1 \
             || security delete-generic-password -a "$USER" -s "$LEGACY:$name" >/dev/null 2>&1; } \
             && echo "removed $name" || die "No secret named '$name'." ;;
    *)     usage ;;
  esac ;;
libsecret)
  ls_get() { secret-tool lookup service "$1" account "$name" 2>/dev/null; }
  case "$cmd" in
    set)   v=$(read_silent "$name")
           printf '%s' "$v" | secret-tool store --label="box-secret $name" \
             service "$SERVICE" account "$name" || die "libsecret write failed."
           unset v; echo "stored $name" ;;
    get)   ls_get "$SERVICE" || ls_get "$LEGACY" || die "$missing" ;;
    check) { ls_get "$SERVICE" || ls_get "$LEGACY"; } >/dev/null 2>&1 && exit 0 || exit 1 ;;
    rm)    secret-tool clear service "$SERVICE" account "$name" 2>/dev/null
           secret-tool clear service "$LEGACY" account "$name" 2>/dev/null
           echo "removed $name" ;;
    *)     usage ;;
  esac ;;
esac
